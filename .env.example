# Minimal runtime configuration (non-sensitive template)
PORT=8080
VOICE_MODEL_PROVIDER=gemini-live
VOICE_MODEL_API_KEY=replace_with_provider_key

# Telephony carriers (primary + automatic failover)
PRIMARY_CARRIER=twilio
SECONDARY_CARRIER=telnyx
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_token
TELNYX_API_KEY=KEYxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Async Ghost Tools webhook destination (optional)
GHOST_WEBHOOK_URL=https://hooks.example.internal/voice-events
GHOST_WEBHOOK_SECRET=replace_with_hmac_secret
